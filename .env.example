# Copy to .env and fill in. Never commit .env.

# --- LLM -------------------------------------------------------------
# auto: Anthropic if ANTHROPIC_API_KEY is set, else OpenAI-compatible if OPENAI_BASE_URL is set,
#       else approved static templates (fully offline).
# offline_simulator: clearly-labelled fake LLM for demos/tests (no API calls).
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-haiku-5-5
TONE_JUDGE_ENABLED=true
# Optional OpenAI-compatible provider (e.g. a local Ollama/vLLM server)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=60

# --- Data ------------------------------------------------------------
# Reference date for all "days since/overdue" calculations (YYYY-MM-DD). Default: today.
AS_OF_DATE=
SYNTHETIC_SEED=42
DB_PATH=data/cea.db

# --- RAG -------------------------------------------------------------
EMBEDDING_BACKEND=auto          # auto|sentence_transformers|tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_BACKEND=auto             # auto|chroma|local
VECTOR_STORE_DIR=data/vector_store

# --- Cost estimate on the dashboard (USD per million tokens) ---------
PRICE_INPUT_PER_MTOK=3.0
PRICE_OUTPUT_PER_MTOK=15.0
